# === Secrets & Local Configs（与 bootstrap.ps1 $requiredIgnores 保持同步）===
config.yaml
config.yml
config.local.yaml
.env
.env.*
*.env
*.secret
*.pem
*.key
*.local.json
credentials.json

# === 微信聊天隐私数据（最高敏感，绝不可入库）===
# 这五条不带前导斜杠，故意匹配任意层级，宁可多忽略不可漏。
data/
exports/
raw/
snapshots/
reports/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*_messages.json
*.report.html
# CLI 的 --out 默认值就是 report.html（没有前导点），上面那条 *.report.html 匹配不到它；
# 少了这一行，在仓库根目录跑一次默认命令就会留下一个含聊天聚合数据的未忽略文件。
report.html
.chatlog/
workmem/

# 例外：nlp-service 的词典/停用词/表情映射是入库交付物（词表），不是聊天数据。
# 必须写在 data/ 之后——上面的 data/ 会连 nlp-service/data/ 一起吃掉，
# 表现为 `git add` 静默成功但文件没进去，新 clone 与 CI 上测试全崩。
!nlp-service/data/

# === 模型权重 / 推理缓存（大文件，不入库）===
models/
*.onnx
*.bin
*.safetensors
.hf-cache/
.paddle/

# === Python ===
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# === Node / 前端构建产物（dist 由 npm run build 生成，供 go:embed）===
node_modules/
frontend/dist/
backend-go/internal/web/dist/

# === Go 构建产物 ===
bin/
*.exe
*.exe~
vendor/

# Windows 上 `go build -o analyze ./cmd/analyze` 产出的是**无扩展名**文件，
# 上面的 *.exe 匹配不到它。两条锚定路径，不要图省事写成裸 `analyze` / `server`：
# 无斜线的模式会在任意层级生效，会把 backend-go/cmd/server/ 整个源码目录一起
# 忽略掉——新增文件从此不出现在 git status 里，那比漏ignore两个二进制糟得多。
/analyze
/server
/backend-go/analyze
/backend-go/server

# === IDE / OS ===
.idea/
.vscode/
.DS_Store
Thumbs.db

# === vault-exec 执行状态（本地断点文件，非交付物） ===
.vault-exec-ledger.json

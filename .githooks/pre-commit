#!/usr/bin/env bash
# vault-bootstrap · 零泄露密钥扫描屏障
# 用法: git config core.hooksPath .githooks （已配置）
# 严禁使用 git commit --no-verify 跳过本钩子。
set -u

# 密钥/凭据正则（API key、云凭据、GitHub token、JWT、PEM 私钥）
pattern='(sk-[A-Za-z0-9]{20,}|AKIA[A-Z0-9]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|AIza[A-Za-z0-9_-]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'

# 仅扫描暂存区中新增/修改的文件
files=$(git diff --cached --name-only --diff-filter=ACM)
found=0

for f in $files; do
  [ -f "$f" ] || continue
  # 跳过二进制与明显的大文件
  if grep -aEq "$pattern" "$f" 2>/dev/null; then
    echo "✗ [pre-commit] 检测到疑似密钥/凭据，已拦截: $f"
    grep -anE "$pattern" "$f" 2>/dev/null | head -5 | sed 's/^/    /'
    found=1
  fi
done

if [ "$found" -ne 0 ]; then
  echo ""
  echo "提交被阻止：请移除硬编码密钥，改用环境变量或本地配置（已在 .gitignore）。"
  echo "若确认为误报，需人工核对后处理——严禁 git commit --no-verify 跳过。"
  exit 1
fi

exit 0
